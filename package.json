{
  "name": "ai-frontend-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "pitfall:review": "tsx .ai/tools/pitfall-reviewer/index.ts",
    "pitfall:scan": "tsx .ai/tools/pitfall-scan.ts",
    "prepare": "husky",
    "prettier": "prettier -c --write . --cache",
    "prettier-import-sort": "npm run prettier -- --plugin=@ianvs/prettier-plugin-sort-imports",
    "preview": "rsbuild preview",
    "type-check": "tsc --noEmit",
    "verify": "tsx .ai/tools/verify-wrapper.ts",
    "verify:fix": "eslint src/ --fix && prettier --write src/",
    "verify:raw": "tsc --noEmit && eslint src/ && prettier --check src/"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@ant-design/pro-components": "^2.8.10",
    "@dalydb/sdesign": "^1.11.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "ahooks": "^3.8.0",
    "antd": "^5.29.3",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "diff-match-patch": "^1.0.5",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "lodash-es": "^4.17.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@rsbuild/core": "^2.1.9",
    "@rsbuild/plugin-react": "^2.1.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^25.3.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.3",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "es5-ext"
    ]
  },
  "ai": {
    "description": "AI Frontend - Harness Engineering 驱动开发",
    "entry": "AGENTS.md"
  }
}
